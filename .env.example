# ==========================
# CONFIGURACIÓN MARQRun PRO
# ==========================
# Copiar este archivo a .env y completar con valores reales

# ===== MODO =====
ENVIRONMENT=development
# production | development | testing

# ===== JWT =====
JWT_SECRET_KEY=tu-clave-secreta-super-segura-cambiar-en-produccion-minimo-32-caracteres
JWT_EXPIRATION_HOURS=24

# ===== BASE DE DATOS =====
# SQLite (development)
# DATABASE_URL=sqlite:///database/marqrun.db

# PostgreSQL (production recomendado)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/marqrun

# ===== SERVIDOR =====
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ===== FIREBASE =====
# Ruta al archivo JSON de Firebase Admin SDK
# Obtenerlo de: https://console.firebase.google.com/
FIREBASE_CREDENTIALS_PATH=backend/marqrun-df27a-firebase-adminsdk-fbsvc-b47f8cbaf7.json

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5000

# ===== LOGGING =====
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL
